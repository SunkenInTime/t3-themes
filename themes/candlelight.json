  "css": ":root {\n  color-scheme: dark;\n  --success: #b8a200;\n  --success-foreground: #100c00;\n  --success-surface: #242000;\n  --info: #c9a000;\n  --info-foreground: #100c00;\n  --info-surface: #302300;\n  --chart-1: #c99700;\n  --chart-2: #b8a200;\n  --chart-3: #ed8600;\n  --chart-4: #a78700;\n  --chart-5: #d1ac00;\n  --chart-6: #bb9700;\n}\n::selection {\n  background: #4e3800;\n  color: #e3b600;\n}\n.chat-markdown a { color: #d4aa00; }\n.chat-markdown-codeblock pre,\n.chat-markdown-codeblock code,\n.chat-markdown-codeblock code span {\n  color: #bb9700 !important;\n  text-shadow: none !important;\n}\n::-webkit-scrollbar { background: #100c00; }\n::-webkit-scrollbar-thumb { background: #493700; }\n::-webkit-scrollbar-thumb:hover { background: #705300; }"
