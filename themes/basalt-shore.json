  "css": "/* Zed fonts: UI is Menlo; the editor font .ZedMono is Lilex, used here only if installed */\n:root{--bs-ui:Menlo,ui-monospace,SFMono-Regular,monospace;--bs-code:Lilex,Menlo,ui-monospace,SFMono-Regular,monospace;--font-sans:var(--bs-ui);--default-font-family:var(--bs-ui);--font-mono:var(--bs-code);--default-mono-font-family:var(--bs-code)}\n/* light values first; .dark must stay after :root to win at equal specificity */\n:root{--bs-link:#0e7c69;--bs-sel:#0e7c6933;--bs-thumb:#9aa4a480;--bs-thumb-hover:#8a9494}\n.dark{--bs-link:#7fd8c4;--bs-sel:#7fd8c42e;--bs-thumb:#464c4e80;--bs-thumb-hover:#535a5b}\nbody{font-family:var(--bs-ui) !important}\n.chat-markdown-codeblock,.chat-markdown code,pre,code{font-family:var(--bs-code) !important}\n.chat-markdown a{color:var(--bs-link)}\n::selection{background:var(--bs-sel)}\n::-webkit-scrollbar-thumb,[data-slot=\"scroll-area-thumb\"]{background:var(--bs-thumb) !important}\n::-webkit-scrollbar-thumb:hover,[data-slot=\"scroll-area-thumb\"]:hover{background:var(--bs-thumb-hover) !important}"
