---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found · T3 Themes">
  <section class="py-20 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-ink-muted">404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight">
      No theme here.
    </h1>
    <p class="mt-4 text-ink-muted">
      This page doesn't exist — maybe the theme was renamed or removed.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-accent px-5 py-2 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
      >Browse all themes</a
    >
  </section>
</Layout>
