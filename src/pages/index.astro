---
import ThemeCard from "../components/ThemeCard.astro";
import Layout from "../layouts/Layout.astro";
import { communityThemes, officialThemes } from "../lib/themes";
---

<Layout>
  <section class="mb-12 max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight">
      Themes for <span class="text-accent">T3Code</span>
    </h1>
    <p class="mt-3 text-ink-muted">
      A community gallery of custom color themes. Every preview is rendered with
      T3Code's own theme engine — click a theme, copy its JSON, and paste it into
      <span class="text-ink">Settings → Themes → Import theme</span>.
    </p>
    <p class="mt-2 text-sm text-ink-muted">
      Made something nice? <a
        href="https://github.com/SunkenInTime/t3-themes#submitting-a-theme"
        class="underline hover:text-ink">Submit it with a pull request.</a
      >
    </p>
  </section>

  <section>
    <h2 class="mb-4 text-sm font-medium uppercase tracking-widest text-ink-muted">
      Built-in themes
    </h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {officialThemes.map((theme) => <ThemeCard theme={theme} />)}
    </div>
  </section>

  <section id="community" class="mt-12">
    <h2 class="mb-4 text-sm font-medium uppercase tracking-widest text-ink-muted">
      Community themes
    </h2>
    {
      communityThemes.length === 0 ? (
        <p class="text-ink-muted">No community themes yet — be the first to submit one.</p>
      ) : (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {communityThemes.map((theme) => (
            <ThemeCard theme={theme} />
          ))}
        </div>
      )
    }
  </section>
</Layout>
