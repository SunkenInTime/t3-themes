---
import CommunityGrid, { type CardData } from "../components/CommunityGrid";
import Layout from "../layouts/Layout.astro";
import { themeShot } from "../lib/shots";
import { communityThemes, lightDark } from "../lib/themes";
import { getThemeModes } from "../vendor/t3code/themePalette";

const cards: CardData[] = communityThemes.map((theme) => {
  const { definition } = theme;
  return {
    id: definition.id,
    label: definition.label,
    byline: theme.author ? `by ${theme.author}` : "Community",
    modes: getThemeModes(definition).join(" · "),
    shotLight: themeShot(definition.id, "light"),
    shotDark: themeShot(definition.id, "dark"),
    surface: lightDark(definition, "surface"),
    text: lightDark(definition, "text"),
    textMuted: lightDark(definition, "textMuted"),
    border: lightDark(definition, "border"),
    swatches: (["canvas", "sidebar", "surface", "accent", "messageAction"] as const).map(
      (role) => lightDark(definition, role),
    ),
    addedAt: theme.addedAt,
  };
});

const accents = communityThemes.map(({ definition }) => ({
  id: definition.id,
  label: definition.label,
  accent: lightDark(definition, "accent"),
}));
---

<Layout>
  <section class="mb-14 max-w-2xl">
    <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Every color of T3Code.
    </h1>
    <p class="mt-4 text-lg text-ink-muted">
      Themes made by the community, photographed in the real app. Copy a theme's
      JSON and paste it into
      <span class="text-ink">Settings → Themes → Import theme</span>.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-2" aria-label="Jump to a theme">
      {
        accents.map(({ id, label, accent }) => (
          <a
            href={`/themes/${id}/`}
            title={label}
            aria-label={label}
            class="block h-4 w-4 rounded-full ring-1 ring-inset ring-black/10 transition-transform hover:scale-125 dark:ring-white/15"
            style={`background-color: ${accent}`}
          />
        ))
      }
    </div>
  </section>

  <section id="community">
    {
      communityThemes.length === 0 ? (
        <p class="text-ink-muted">
          No community themes yet — yours could be the first.
          <a
            href="https://github.com/SunkenInTime/t3-themes/new/main/themes"
            rel="noopener"
            class="underline transition-colors hover:text-ink"
          >
            Submit one with a pull request.
          </a>
        </p>
      ) : (
        <CommunityGrid client:load themes={cards} />
      )
    }
  </section>
</Layout>
