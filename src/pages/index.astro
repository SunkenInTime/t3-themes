---
import ThemeCard from "../components/ThemeCard.astro";
import Layout from "../layouts/Layout.astro";
import { allThemes, communityThemes, officialThemes } from "../lib/themes";
import { getThemeColorsForMode } from "../vendor/t3code/themePalette";

const accents = allThemes.map(({ definition }) => ({
  id: definition.id,
  label: definition.label,
  accent: getThemeColorsForMode(definition, definition.appearance)!.accent,
}));
---

<Layout>
  <section class="mb-14 max-w-2xl">
    <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Every color of T3Code.
    </h1>
    <p class="mt-4 text-lg text-ink-muted">
      Community-made themes, photographed in the real app. Copy a theme's JSON and
      paste it into <span class="text-ink">Settings → Themes → Import theme</span>.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-2" aria-label="Jump to a theme">
      {
        accents.map(({ id, label, accent }) => (
          <a
            href={`/themes/${id}/`}
            title={label}
            aria-label={label}
            class="block h-4 w-4 rounded-full ring-1 ring-inset ring-white/15 transition-transform hover:scale-125"
            style={`background-color: ${accent}`}
          />
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-ink-muted">
      Built-in themes
    </h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {officialThemes.map((theme) => <ThemeCard theme={theme} />)}
    </div>
  </section>

  <section id="community" class="mt-14">
    <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-ink-muted">
      Community themes
    </h2>
    {
      communityThemes.length === 0 ? (
        <p class="text-ink-muted">
          No community themes yet — yours could be the first.
          <a
            href="https://github.com/SunkenInTime/t3-themes/new/main/themes"
            rel="noopener"
            class="underline transition-colors hover:text-ink"
          >
            Submit one with a pull request.
          </a>
        </p>
      ) : (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {communityThemes.map((theme) => (
            <ThemeCard theme={theme} />
          ))}
        </div>
      )
    }
  </section>
</Layout>
