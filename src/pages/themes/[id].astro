---
import CopyJsonButton from "../../components/CopyJsonButton";
import LikeButton from "../../components/LikeButton";
import LivePreview from "../../components/LivePreview";
import Layout from "../../layouts/Layout.astro";
import { themeShot } from "../../lib/shots";
import { allThemes, modePair, previewColors, resolvedModes } from "../../lib/themes";
import { ThemeWireframe } from "../../vendor/t3code/components/settings/ThemeWireframe";
import { THEME_COLOR_ROLES, type ThemeColorRole } from "../../vendor/t3code/themePalette";

export function getStaticPaths() {
  return allThemes.map((theme) => ({
    params: { id: theme.definition.id },
    props: { theme },
  }));
}

const { theme } = Astro.props;
const { definition } = theme;
const modes = resolvedModes(definition);
const pagePalettes = modePair(definition);
const roleLabel = (role: ThemeColorRole) => role.replace(/([A-Z])/g, " $1").toLowerCase();

// Group the color roles by the part of the app they paint. Order and
// membership are derived by prefix so new upstream roles land somewhere.
const GROUPS: Array<{ label: string; prefixes: string[] }> = [
  { label: "surfaces", prefixes: ["canvas", "chrome", "surface", "border", "input"] },
  { label: "text", prefixes: ["text", "placeholder", "secondaryLabel", "iconMuted"] },
  { label: "accent & controls", prefixes: ["accent", "focus", "secondary", "muted"] },
  { label: "conversation & code", prefixes: ["message", "code"] },
  { label: "sidebar", prefixes: ["sidebar"] },
  { label: "toolbar", prefixes: ["toolbar"] },
  { label: "terminal", prefixes: ["terminal"] },
  { label: "status", prefixes: ["error", "warning", "update"] },
];
const groupOf = (role: string) =>
  GROUPS.find((group) => group.prefixes.some((prefix) => role.startsWith(prefix)))?.label ??
  "other";
const groupedRoles = [...GROUPS.map((group) => group.label), "other"]
  .map((label) => ({
    label,
    roles: THEME_COLOR_ROLES.filter((role) => groupOf(role) === label),
  }))
  .filter((group) => group.roles.length > 0);
---

<Layout
  title={`${definition.label} · T3 Themes`}
  description={theme.description}
  paletteLight={pagePalettes.light}
  paletteDark={pagePalettes.dark}
>
  <a href="/" class="font-mono text-xs text-ink-muted transition-colors hover:text-ink"
    >← all themes</a
  >

  <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl font-semibold tracking-tight">{definition.label}</h1>
      <p class="mt-1 text-ink-muted">
        {theme.official ? "Built into T3Code" : theme.author ? `by ` : "Community theme"}
        {
          !theme.official && theme.author && (
            <a
              href={`https://github.com/${theme.author}`}
              rel="noopener"
              class="underline transition-colors hover:text-ink"
            >
              {theme.author}
            </a>
          )
        }
      </p>
      {theme.description && <p class="mt-2 max-w-xl text-ink-muted">{theme.description}</p>}
    </div>
    <div class="flex items-center gap-3">
      <LikeButton client:load themeId={definition.id} />
      <CopyJsonButton client:load json={theme.json} />
    </div>
  </div>

  <p class="mt-6 rounded-lg border border-border/60 bg-card px-4 py-3 text-sm text-ink-muted">
    This page is wearing <span class="text-ink">{definition.label}</span> — everything you
    see is drawn with the theme's own colors.
  </p>

  <LivePreview client:load definition={definition} official={theme.official} />

  <!-- The live preview is the visual; wireframes only fill in on builds
       without the demo assets (where the live preview can't render). -->
  {
    modes.some(({ mode }) => !themeShot(definition.id, mode)) && (
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {modes.map(({ mode }) => (
          <figure>
            <ThemeWireframe
              className="aspect-[16/10]"
              panes={[{ colors: previewColors(definition, mode)! }]}
            />
            <figcaption class="mt-2 text-center font-mono text-xs text-ink-muted">{mode}</figcaption>
          </figure>
        ))}
      </div>
    )
  }

  <section class="mt-10">
    <h2 class="mb-3 font-mono text-xs uppercase tracking-widest text-ink-muted">
      How to install
    </h2>
    <ol class="list-inside list-decimal space-y-1 text-sm text-ink-muted">
      <li>Copy the theme JSON with the button above.</li>
      <li>In T3Code, open <span class="text-ink">Settings → Themes → Import theme</span>.</li>
      <li>Paste the JSON and confirm.</li>
    </ol>
    {
      theme.sourcePath && (
        <p class="mt-3 font-mono text-xs text-ink-muted">
          source:{" "}
          <a
            href={`https://github.com/SunkenInTime/t3-themes/blob/main/${theme.sourcePath}`}
            rel="noopener"
            class="underline transition-colors hover:text-ink"
          >
            {theme.sourcePath}
          </a>
        </p>
      )
    }
  </section>

  {
    modes.map(({ mode, colors }) => (
      <section class="mt-10">
        <h2 class="mb-4 font-mono text-xs uppercase tracking-widest text-ink-muted">
          {mode} palette
        </h2>
        <div class="space-y-6">
          {groupedRoles.map((group) => (
            <div>
              <h3 class="mb-2 font-mono text-[11px] text-ink-muted">{group.label}</h3>
              <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
                {group.roles.map((role) => (
                  <div class="flex items-center gap-3 rounded-lg border border-border/60 bg-card p-2">
                    <span
                      class="h-8 w-8 shrink-0 rounded-md border border-border/60"
                      style={`background-color: ${colors[role]}`}
                    />
                    <span class="min-w-0">
                      <span class="block truncate text-xs">{roleLabel(role)}</span>
                      <span class="block font-mono text-xs text-ink-muted">{colors[role]}</span>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }
</Layout>
