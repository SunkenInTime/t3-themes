---
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import {
  THEME_COLOR_ROLES,
  getStandardThemeColors,
  getThemeColorVariable,
  type ThemeColors,
} from "../vendor/t3code/themePalette";

interface Props {
  title?: string;
  description?: string;
  /** Palettes the page wears per system scheme; default is T3Code's neutral
   * standard theme. Theme detail pages pass their own theme's modes so the
   * page previews it — single-mode themes pass the same palette twice. */
  paletteLight?: ThemeColors;
  paletteDark?: ThemeColors;
}

const {
  title = "T3 Themes",
  description = "A community gallery of themes for T3Code.",
  paletteLight = getStandardThemeColors("light"),
  paletteDark = getStandardThemeColors("dark"),
} = Astro.props;

// light-dark() resolves per the visitor's color scheme at paint time.
const themeStyle = THEME_COLOR_ROLES.map((role) => {
  const value =
    paletteLight[role] === paletteDark[role]
      ? paletteLight[role]
      : `light-dark(${paletteLight[role]}, ${paletteDark[role]})`;
  return `${getThemeColorVariable(role)}: ${value}`;
}).join("; ");
---

<!doctype html>
<html lang="en" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      // Resolve the color scheme before first paint. Preference lives in
      // localStorage ("light" | "dark"; absent = follow system). Both
      // light-dark() colors (via color-scheme) and Tailwind dark: variants
      // (via data-theme) key off what this sets.
      (() => {
        const KEY = "tt-scheme";
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        // In-memory fallback keeps the toggle working when storage is blocked.
        let memoryPref = null;
        const readPref = () => {
          let value = memoryPref;
          try {
            value = localStorage.getItem(KEY);
          } catch {}
          return value === "light" || value === "dark" ? value : "system";
        };
        const writePref = (pref) => {
          memoryPref = pref === "system" ? null : pref;
          try {
            if (pref === "system") localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, pref);
          } catch {}
        };
        const listeners = new Set();
        const apply = () => {
          const pref = readPref();
          const mode = pref === "system" ? (media.matches ? "dark" : "light") : pref;
          root.dataset.theme = mode;
          root.style.colorScheme = mode;
          for (const listener of listeners) listener(pref);
        };
        media.addEventListener("change", apply);
        // Re-assert after bfcache restores, tab switches, and any storage
        // change (including another tab toggling, or storage being cleared).
        window.addEventListener("pageshow", apply);
        document.addEventListener("visibilitychange", apply);
        window.addEventListener("storage", (event) => {
          if (event.key === KEY || event.key === null) apply();
        });
        apply();
        window.__scheme = { readPref, writePref, apply, onChange: (fn) => listeners.add(fn) };
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <header class="border-b border-border/60">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="font-display text-lg font-semibold tracking-tight">
          t3<span class="text-accent">·</span>themes
        </a>
        <nav class="flex items-center gap-5 text-sm text-ink-muted">
          <a href="/#community" class="transition-colors hover:text-ink">Community</a>
          <a
            href="https://github.com/pingdotgg/t3code"
            rel="noopener"
            target="_blank"
            class="transition-colors hover:text-ink">T3Code</a
          >
          <button
            id="scheme-toggle"
            type="button"
            class="flex h-8 w-8 items-center justify-center rounded-full border border-border/60 text-ink-muted transition-colors hover:border-border hover:text-ink"
          >
            <svg data-icon="system" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="14" rx="2"></rect>
              <path d="M8 21h8M12 18v3"></path>
            </svg>
            <svg data-icon="light" hidden width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg data-icon="dark" hidden width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
            </svg>
          </button>
          <a
            href="https://github.com/SunkenInTime/t3-themes/new/main/themes"
            rel="noopener"
            class="rounded-full bg-accent px-3.5 py-1.5 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
            >Submit a theme</a
          >
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>
    <script is:inline>
      (() => {
        const button = document.getElementById("scheme-toggle");
        if (!button || !window.__scheme) return;
        const order = ["system", "light", "dark"];
        const labels = {
          system: "Color scheme: system (click for light)",
          light: "Color scheme: light (click for dark)",
          dark: "Color scheme: dark (click for system)",
        };
        const render = (pref) => {
          for (const icon of button.querySelectorAll("[data-icon]")) {
            // toggleAttribute: SVG elements don't implement the .hidden property
            icon.toggleAttribute("hidden", icon.dataset.icon !== pref);
          }
          button.setAttribute("aria-label", labels[pref]);
          button.title = labels[pref];
        };
        button.addEventListener("click", () => {
          const next = order[(order.indexOf(window.__scheme.readPref()) + 1) % order.length];
          window.__scheme.writePref(next);
          window.__scheme.apply();
        });
        // Keeps the icon honest whenever the scheme re-resolves (other tabs,
        // bfcache restores, storage changes) — not just on our own clicks.
        window.__scheme.onChange(render);
        render(window.__scheme.readPref());
      })();
    </script>
    <footer class="border-t border-border/60">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-6 py-6 font-mono text-xs text-ink-muted"
      >
        <span>Not affiliated with T3 Tools.</span>
        <span>
          Previews rendered by the MIT-licensed
          <a
            href="https://github.com/pingdotgg/t3code"
            rel="noopener"
            class="underline transition-colors hover:text-ink">t3code</a
          > theme engine.
        </span>
      </div>
    </footer>
  </body>
</html>
