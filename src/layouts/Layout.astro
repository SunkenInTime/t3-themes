---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
import {
  T3_CHAT_THEME,
  THEME_COLOR_ROLES,
  getThemeColorVariable,
  getThemeColorsForMode,
  type ThemeAppearance,
  type ThemeColors,
} from "../vendor/t3code/themePalette";

interface Props {
  title?: string;
  description?: string;
  /** Palette the whole page wears; defaults to T3 Chat dark. Theme detail
   * pages pass their own theme here so the page itself previews it. */
  palette?: ThemeColors;
  appearance?: ThemeAppearance;
}

const {
  title = "T3 Themes",
  description = "A community gallery of themes for T3Code.",
  palette = getThemeColorsForMode(T3_CHAT_THEME, "dark")!,
  appearance = "dark",
} = Astro.props;

const themeStyle = THEME_COLOR_ROLES.map(
  (role) => `${getThemeColorVariable(role)}: ${palette[role]}`,
).join("; ");
---

<!doctype html>
<html lang="en" class={appearance === "dark" ? "dark" : undefined} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased">
    <header class="border-b border-border/60">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="font-display text-lg font-semibold tracking-tight">
          t3<span class="text-accent">·</span>themes
        </a>
        <nav class="flex items-center gap-5 text-sm text-ink-muted">
          <a href="/#community" class="transition-colors hover:text-ink">Community</a>
          <a
            href="https://github.com/pingdotgg/t3code"
            rel="noopener"
            target="_blank"
            class="transition-colors hover:text-ink">T3Code</a
          >
          <a
            href="https://github.com/SunkenInTime/t3-themes/new/main/themes"
            rel="noopener"
            class="rounded-full bg-accent px-3.5 py-1.5 text-sm font-medium text-accent-foreground transition-opacity hover:opacity-90"
            >Submit a theme</a
          >
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>
    <footer class="border-t border-border/60">
      <div
        class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-6 py-6 font-mono text-xs text-ink-muted"
      >
        <span>Not affiliated with T3 Tools.</span>
        <span>
          Previews rendered by the MIT-licensed
          <a
            href="https://github.com/pingdotgg/t3code"
            rel="noopener"
            class="underline transition-colors hover:text-ink">t3code</a
          > theme engine.
        </span>
      </div>
    </footer>
  </body>
</html>
