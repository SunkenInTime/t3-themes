---
import { ThemeWireframe } from "../vendor/t3code/components/settings/ThemeWireframe";
import { themeShot } from "../lib/shots";
import { wireframePanes, type GalleryTheme } from "../lib/themes";
import { getThemeModes } from "../vendor/t3code/themePalette";
import LikeButton from "./LikeButton";

interface Props {
  theme: GalleryTheme;
}

const { theme } = Astro.props;
const { definition } = theme;
const modes = getThemeModes(definition);
const shot = themeShot(definition.id, definition.appearance);
const altMode = modes.find((mode) => mode !== definition.appearance);
const altShot = altMode ? themeShot(definition.id, altMode) : null;
const panes = shot ? [] : wireframePanes(definition);
---

<article
  class="group relative rounded-xl border border-border/60 bg-surface p-3 transition-colors hover:border-border"
>
  <a href={`/themes/${definition.id}/`} class="block">
    <span class="relative block aspect-[16/10] overflow-hidden rounded-lg border border-border/60">
      {
        shot ? (
          <>
            <img
              src={shot}
              alt={`T3Code with the ${definition.label} theme`}
              class="h-full w-full object-cover object-left-top"
              loading="lazy"
              decoding="async"
            />
            {altShot && (
              <img
                src={altShot}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full object-cover object-left-top opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                loading="lazy"
                decoding="async"
              />
            )}
          </>
        ) : (
          <ThemeWireframe className="h-full rounded-none border-0" panes={panes} />
        )
      }
    </span>
    <span class="mt-3 flex items-baseline justify-between gap-2 px-1">
      <span class="truncate font-medium">{definition.label}</span>
      <span class="shrink-0 text-xs text-ink-muted">{modes.join(" · ")}</span>
    </span>
    <span class="mt-0.5 block truncate px-1 text-sm text-ink-muted">
      {theme.official ? "Built-in" : theme.author ? `by ${theme.author}` : "Community"}
    </span>
  </a>
  <div class="absolute right-3 top-3 z-10">
    <LikeButton client:visible themeId={definition.id} />
  </div>
</article>
