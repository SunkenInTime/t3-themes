+
+import { DEMO_THREAD_ID, demoServerConfig, demoShellSnapshot, demoThreadProjection } from "./fixtures";
+
+// The fixtures decode through the live contract schemas on import; this fails
+// with the offending field when an upstream schema change breaks them.
+describe("demo fixtures", () => {
+  it("decode against the current contracts", () => {
+    expect(demoServerConfig.providers.length).toBeGreaterThan(0);
+    expect(demoShellSnapshot.threads.some((thread) => thread.id === DEMO_THREAD_ID)).toBe(true);
