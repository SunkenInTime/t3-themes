+++ b/apps/web/src/demo/server.ts
@@ -0,0 +1,361 @@
+/**
+ * In-browser backend for the static demo build (theme previews). Serves the
+ * real `WsRpcGroup` contract over in-memory WebSocket pairs and answers the
+ * few HTTP routes the client calls at startup, so the unmodified web app runs
+ * on fixture data with no server and no network.
+ *
+ * Only what the demo shows is implemented. Every other RPC gets a generated
+ * default (a stream that stays open, or an authorization error), so methods
+ * added upstream do not break the build; `?demo-debug` logs each one called.
+ */
+import {
+  AuthSessionState,
+  AuthWebSocketTicketResult,
+  EnvironmentAuthorizationError,
+  ExecutionEnvironmentDescriptor,
+  ORCHESTRATION_V2_WS_METHODS,
+  OrchestrationV2ShellHttpSnapshot,
+  type OrchestrationV2ShellStreamItem,
+  type OrchestrationV2ThreadStreamItem,
+  RpcScopeAuthorization,
+  type ServerConfigStreamEvent,
+  type ServerLifecycleStreamEvent,
+  type ServerSettings,
+  WS_METHODS,
+  WsRpcGroup,
+} from "@t3tools/contracts";
+import { applyServerSettingsPatch } from "@t3tools/shared/serverSettings";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Queue from "effect/Queue";
+import * as Schema from "effect/Schema";
+import * as Stream from "effect/Stream";
+import { RpcSchema, RpcSerialization, RpcServer } from "effect/rpc";
+import * as Socket from "effect/socket/Socket";
+import * as SocketServer from "effect/socket/SocketServer";
+
+import {
+  demoDescriptor,
+  demoServerConfig,
+  demoShellSnapshot,
+  demoThreadProjection,
+} from "./fixtures";
+
+const debug =
+  typeof window !== "undefined" && new URLSearchParams(window.location.search).has("demo-debug");
+const log = (...args: ReadonlyArray<unknown>) => {
+  if (debug) console.info("[demo]", ...args);
+};
+
+// ---------------------------------------------------------------------------
+// In-memory WebSocket pair
+// ---------------------------------------------------------------------------
+
+type Listener = (event: unknown) => void;
+
+class DemoSocketEndpoint {
+  static readonly CONNECTING = 0;
+  static readonly OPEN = 1;
+  static readonly CLOSING = 2;
+  static readonly CLOSED = 3;
+  readonly CONNECTING = 0;
+  readonly OPEN = 1;
+  readonly CLOSING = 2;
+  readonly CLOSED = 3;
+
+  readyState = DemoSocketEndpoint.CONNECTING;
+  binaryType = "arraybuffer";
+  protocol = "";
+  extensions = "";
+  bufferedAmount = 0;
+  peer: DemoSocketEndpoint | null = null;
+  onopen: Listener | null = null;
+  onmessage: Listener | null = null;
+  onclose: Listener | null = null;
+  onerror: Listener | null = null;
+
+  private listeners = new Map<string, Set<Listener>>();
+  private buffered: Array<unknown> = [];
+
+  addEventListener(type: string, listener: Listener): void {
+    let set = this.listeners.get(type);
+    if (!set) this.listeners.set(type, (set = new Set()));
+    set.add(listener);
+    if (type === "message" && this.buffered.length > 0) {
+      const pending = this.buffered.splice(0);
+      queueMicrotask(() => pending.forEach((event) => this.dispatch("message", event)));
+    }
+  }
+
+  removeEventListener(type: string, listener: Listener): void {
+    this.listeners.get(type)?.delete(listener);
+  }
+
+  dispatch(type: string, event: unknown): void {
+    const handler = (this as unknown as Record<string, Listener | null>)[`on${type}`];
+    const set = this.listeners.get(type);
+    if (!handler && (!set || set.size === 0)) {
+      if (type === "message") this.buffered.push(event);
+      return;
+    }
+    handler?.(event);
+    set?.forEach((listener) => listener(event));
+  }
+
+  open(): void {
+    this.readyState = DemoSocketEndpoint.OPEN;
+    queueMicrotask(() => this.dispatch("open", { type: "open" }));
+  }
+
+  send(data: unknown): void {
+    const peer = this.peer;
+    if (!peer || peer.readyState !== DemoSocketEndpoint.OPEN) return;
+    queueMicrotask(() => peer.dispatch("message", { type: "message", data }));
+  }
+
+  close(code = 1000, reason = ""): void {
+    if (this.readyState === DemoSocketEndpoint.CLOSED) return;
+    this.readyState = DemoSocketEndpoint.CLOSED;
+    const peer = this.peer;
+    queueMicrotask(() => {
+      this.dispatch("close", { type: "close", code, reason, wasClean: true });
+      if (peer && peer.readyState !== DemoSocketEndpoint.CLOSED) peer.close(code, reason);
+    });
+  }
+}
+
+class DemoConnectionAcceptor {
+  private pending: Array<DemoSocketEndpoint> = [];
+  private listener: ((server: DemoSocketEndpoint) => void) | null = null;
+
+  accept(listener: (server: DemoSocketEndpoint) => void): void {
+    this.listener = listener;
+    this.pending.splice(0).forEach(listener);
+  }
+
+  connectClient(): DemoSocketEndpoint {
+    const client = new DemoSocketEndpoint();
+    const server = new DemoSocketEndpoint();
+    client.peer = server;
+    server.peer = client;
+    server.open();
+    client.open();
+    if (this.listener) this.listener(server);
+    else this.pending.push(server);
+    return client;
+  }
+}
+
+const acceptor = new DemoConnectionAcceptor();
+
+// ---------------------------------------------------------------------------
+// HTTP routes the client calls before and beside the socket
+// ---------------------------------------------------------------------------
+
+const json = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+const encodeJson = <S extends Schema.Top>(schema: S, value: S["Type"]) =>
+  Schema.encodeSync(Schema.toCodecJson(schema))(value);
+
+function demoHttpResponse(url: URL): Response {
+  switch (url.pathname) {
+    case "/.well-known/t3/environment":
+      return json(encodeJson(ExecutionEnvironmentDescriptor, demoDescriptor));
+    case "/api/auth/session":
+      return json(
+        encodeJson(AuthSessionState, {
+          authenticated: true,
+          auth: demoServerConfig.auth,
+          scopes: ["orchestration:read", "orchestration:operate", "access:read"],
+        } as AuthSessionState),
+      );
+    case "/api/auth/websocket-ticket":
+    case "/api/auth/websocket-ticket/rpc":
+    case "/api/auth/websocket-ticket/media":
+      return json(
+        encodeJson(AuthWebSocketTicketResult, {
+          ticket: "demo-ticket",
+          expiresAt: new Date(Date.now() + 5 * 60_000),
+        } as unknown as AuthWebSocketTicketResult),
+      );
+    case "/api/orchestration/shell":
+      return json(encodeJson(OrchestrationV2ShellHttpSnapshot, demoShellSnapshot));
+  }
+  log("HTTP 404", url.pathname);
+  return json({ error: "Not available in the demo" }, 404);
+}
+
+function installNetworkInterceptors(): void {
+  // Effect reads this newer Headers API when decoding responses.
+  const headers = Headers.prototype as unknown as { getSetCookie?: () => Array<string> };
+  headers.getSetCookie ??= () => [];
+
+  const NativeWebSocket = globalThis.WebSocket;
+  const DemoWebSocket = function (url: string | URL, protocols?: string | Array<string>) {
+    const parsed = new URL(String(url), window.location.href);
+    log("WebSocket", parsed.href);
+    if (parsed.host === window.location.host && parsed.pathname.endsWith("/ws")) {
+      return acceptor.connectClient() as unknown as WebSocket;
+    }
+    return new NativeWebSocket(url, protocols);
+  } as unknown as typeof WebSocket;
+  DemoWebSocket.prototype = NativeWebSocket.prototype;
+  Object.assign(DemoWebSocket, { CONNECTING: 0, OPEN: 1, CLOSING: 2, CLOSED: 3 });
+  globalThis.WebSocket = DemoWebSocket;
+
+  const nativeFetch = globalThis.fetch.bind(globalThis);
+  globalThis.fetch = (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = new URL(
+      typeof input === "string" ? input : input instanceof URL ? input.href : input.url,
+      window.location.href,
+    );
+    log("fetch", url.href);
+    const isApi = url.pathname.startsWith("/api/") || url.pathname.startsWith("/.well-known/");
+    if (url.host === window.location.host && isApi) {
+      try {
+        return Promise.resolve(demoHttpResponse(url));
+      } catch (error) {
+        console.error("[demo] could not answer", url.pathname, error);
+        return Promise.resolve(json({ error: String(error) }, 500));
+      }
+    }
+    return nativeFetch(input, init);
+  };
+}
+
+// ---------------------------------------------------------------------------
+// RPC handlers
+// ---------------------------------------------------------------------------
+
+const notInDemo = (method: string) =>
+  new EnvironmentAuthorizationError({
+    message: `Not available in the demo: ${method}`,
+    requiredScope: "orchestration:operate",
+  });
+
+function settingsStore(initial: ServerSettings) {
+  let current = initial;
+  return {
+    get: () => current,
+    update: (patch: Parameters<typeof applyServerSettingsPatch>[1]) =>
+      (current = applyServerSettingsPatch(current, patch)),
+  };
+}
+
+const startedAt = new Date().toISOString();
+
+function overrides(): Record<string, (input: never) => unknown> {
+  const settings = settingsStore(demoServerConfig.settings);
+  const config = (): ServerConfigStreamEvent => ({
+    version: 1,
+    type: "snapshot",
+    config: { ...demoServerConfig, settings: settings.get() },
+  });
+  const ready = {
+    version: 1,
+    sequence: 1,
+    type: "ready",
+    payload: { at: startedAt, environment: demoDescriptor },
+  } as unknown as ServerLifecycleStreamEvent;
+  const forever = <A>(...first: ReadonlyArray<A>) =>
+    Stream.concat(Stream.fromIterable(first), Stream.never);
+
+  return {
+    [WS_METHODS.serverProbe]: () => Effect.succeed({}),
+    [WS_METHODS.serverGetConfig]: () => Effect.sync(() => config().config),
+    [WS_METHODS.serverGetSettings]: () => Effect.sync(settings.get),
+    [WS_METHODS.serverUpdateSettings]: ({ patch }: { patch: never }) =>
+      Effect.sync(() => settings.update(patch)),
+    [WS_METHODS.subscribeServerConfig]: () => forever(config()),
+    [WS_METHODS.subscribeServerLifecycle]: () => forever(ready),
+    [WS_METHODS.serverReportClientActivity]: () => Effect.void,
+    [ORCHESTRATION_V2_WS_METHODS.subscribeShell]: () =>
+      forever<OrchestrationV2ShellStreamItem>(
+        { kind: "snapshot", snapshot: demoShellSnapshot },
+        { kind: "synchronized" },
+      ),
+    [ORCHESTRATION_V2_WS_METHODS.subscribeThread]: ({ threadId }: { threadId: string }) => {
+      const projection = demoThreadProjection(threadId);
+      if (!projection) return Stream.fail(notInDemo(`thread ${threadId}`));
+      return forever<OrchestrationV2ThreadStreamItem>(
+        { kind: "snapshot", snapshotSequence: 1, projection } as OrchestrationV2ThreadStreamItem,
+        { kind: "synchronized" },
+      );
+    },
+    [ORCHESTRATION_V2_WS_METHODS.getThreadProjection]: ({ threadId }: { threadId: string }) => {
+      const projection = demoThreadProjection(threadId);
+      return projection ? Effect.succeed(projection) : Effect.fail(notInDemo(`thread ${threadId}`));
+    },
+    [ORCHESTRATION_V2_WS_METHODS.searchThreads]: () => Effect.succeed({ matches: [] }),
+    [ORCHESTRATION_V2_WS_METHODS.getArchivedShellSnapshot]: () =>
+      Effect.succeed({ schemaVersion: 1, snapshotSequence: 1, projects: [], threads: [] }),
+    // Fixture projects are not repositories on disk; answer so the app stops retrying.
+    [WS_METHODS.vcsListRefs]: () =>
+      Effect.succeed({
+        refs: [],
+        isRepo: true,
+        hasPrimaryRemote: false,
+        nextCursor: null,
+        totalCount: 0,
+      }),
+  };
+}
+
+/** Every method in the contract: the demo's own handler, or a generated default. */
+function handlers() {
+  const own = overrides();
+  const all: Record<string, unknown> = {};
+  for (const [tag, rpc] of WsRpcGroup.requests) {
+    const handler = own[tag];
+    if (handler) {
+      all[tag] = (input: never) => {
+        log("rpc", tag);
+        return handler(input);
+      };
+    } else if (RpcSchema.isStreamSchema(rpc.successSchema)) {
+      all[tag] = () => {
+        log("rpc (default: open stream)", tag);
+        return Stream.never;
+      };
+    } else {
+      all[tag] = () => {
+        log("rpc (default: not available)", tag);
+        return Effect.fail(notInDemo(tag));
+      };
+    }
+  }
+  return all as never;
+}
+
+const socketServerLayer = Layer.succeed(
+  SocketServer.SocketServer,
+  SocketServer.SocketServer.of({
+    address: { _tag: "TcpAddress", hostname: "demo", port: 0 },
+    run: <R, E, A>(handler: (socket: Socket.Socket) => Effect.Effect<A, E, R>) =>
+      Effect.gen(function* () {
+        const queue = yield* Queue.unbounded<DemoSocketEndpoint>();
+        acceptor.accept((endpoint) => Queue.offerUnsafe(queue, endpoint));
+        return yield* Queue.take(queue).pipe(
+          Effect.flatMap((endpoint) =>
+            Socket.fromWebSocket(Effect.succeed(endpoint as unknown as globalThis.WebSocket)).pipe(
+              Effect.flatMap((socket) => Effect.forkChild(handler(socket))),
+            ),
+          ),
+          Effect.forever,
+        );
+      }),
+  }),
+);
+
+export function startDemoServer(): void {
+  installNetworkInterceptors();
+  const server = RpcServer.layer(WsRpcGroup, { disableTracing: true }).pipe(
+    Layer.provide(WsRpcGroup.toLayer(Effect.succeed(handlers()))),
+    // The real server checks scopes here; the demo session may do anything it offers.
+    Layer.provide(Layer.succeed(RpcScopeAuthorization)((effect) => effect)),
+    Layer.provide(RpcServer.layerProtocolSocketServer),
+    Layer.provide(socketServerLayer),
+    Layer.provide(RpcSerialization.layerJson),
+  );
+  Effect.runFork(Layer.launch(server));
+}
