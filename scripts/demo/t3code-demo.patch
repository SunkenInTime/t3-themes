@@ -0,0 +1,356 @@
+// Demo data for the static theme-preview build: one environment with a few
+// projects and threads, and one conversation that exercises the main chat
+// surfaces (markdown, inline code, code blocks, lists). Every value is decoded
+// through the real contract schemas, so a shape that drifts upstream fails
+// loudly here instead of rendering wrong.
+import {
+  ExecutionEnvironmentDescriptor,
+  ORCHESTRATION_PROTOCOL_VERSION,
+  OrchestrationV2ShellSnapshot,
+  OrchestrationV2ThreadProjection,
+  ServerConfig,
+} from "@t3tools/contracts";
+import { DEFAULT_RESOLVED_KEYBINDINGS } from "@t3tools/shared/keybindings";
+import * as Schema from "effect/Schema";
+
+// Fixtures are written as wire JSON (ISO date strings), like a real server sends.
+const decodeJson = <S extends Schema.Top>(schema: S) =>
+  Schema.decodeUnknownSync(Schema.toCodecJson(schema));
+
+export const DEMO_ENVIRONMENT_ID = "demo";
+export const DEMO_THREAD_ID = "thread-theme-css";
+
+const now = Date.now();
+const minutesAgo = (minutes: number) => new Date(now - minutes * 60_000).toISOString();
+
+const PROVIDER = "claudeAgent";
+const MODEL = "claude-opus-5-5";
+
+export const demoDescriptor = decodeJson(ExecutionEnvironmentDescriptor)({
+  environmentId: DEMO_ENVIRONMENT_ID,
+  label: "MacBook Pro",
+  platform: { os: "darwin", arch: "arm64" },
+  serverVersion: import.meta.env.APP_VERSION || "0.0.0",
+  // The client refuses servers on another protocol; the demo speaks the bundled one.
+  orchestrationProtocolVersion: ORCHESTRATION_PROTOCOL_VERSION,
+  capabilities: { repositoryIdentity: false, threadSettlement: true, threadSnooze: true },
+});
+
+export const demoServerConfig: ServerConfig = {
+  ...decodeJson(ServerConfig)({
+    environment: Schema.encodeSync(Schema.toCodecJson(ExecutionEnvironmentDescriptor))(demoDescriptor),
+    auth: {
+      policy: "unsafe-no-auth",
+      bootstrapMethods: [],
+      sessionMethods: [],
+      sessionCookieName: "t3-demo-session",
+    },
+    cwd: "~/code/t3code",
+    keybindingsConfigPath: "~/.t3/keybindings.json",
+    keybindings: [],
+    issues: [],
+    providers: [
+      {
+        instanceId: PROVIDER,
+        driver: PROVIDER,
+        displayName: "Claude",
+        enabled: true,
+        installed: true,
+        version: "2.3.0",
+        status: "ready",
+        auth: { status: "authenticated", label: "Claude Max" },
+        checkedAt: minutesAgo(1),
+        models: [{ slug: MODEL, name: "Opus 5.5", isCustom: false, capabilities: null }],
+      },
+    ],
+    availableEditors: [],
+    observability: {
+      logsDirectoryPath: "~/.t3/logs",
+      localTracingEnabled: false,
+      otlpTracesEnabled: false,
+      otlpMetricsEnabled: false,
+    },
+    settings: {},
+  }),
+  keybindings: DEFAULT_RESOLVED_KEYBINDINGS,
+};
+
+// ---------------------------------------------------------------------------
+// Projects and thread rows
+// ---------------------------------------------------------------------------
+
+const projects = [
+  { id: "project-t3code", title: "t3code", workspaceRoot: "~/code/t3code" },
+  { id: "project-site", title: "marketing-site", workspaceRoot: "~/code/marketing-site" },
+  { id: "project-mobile", title: "mobile-app", workspaceRoot: "~/code/mobile-app" },
+].map((project) => ({
+  ...project,
+  repositoryIdentity: null,
+  defaultModelSelection: null,
+  scripts: [],
+  createdAt: minutesAgo(60 * 24 * 30),
+  updatedAt: minutesAgo(5),
+}));
+
+interface ThreadSpec {
+  readonly id: string;
+  readonly projectId: string;
+  readonly title: string;
+  readonly branch: string | null;
+  readonly updatedMinutesAgo: number;
+  readonly status?: "idle" | "running";
+  readonly settled?: boolean;
+  readonly lastMessage?: string;
+  readonly itemCount?: number;
+}
+
+const threadSpecs: ReadonlyArray<ThreadSpec> = [
+  {
+    id: DEMO_THREAD_ID,
+    projectId: "project-t3code",
+    title: "Let themes carry custom CSS",
+    branch: "feat/theme-css",
+    updatedMinutesAgo: 2,
+    lastMessage: "Theme CSS now applies after the app's styles.",
+    itemCount: 4,
+  },
+  {
+    id: "thread-composer",
+    projectId: "project-t3code",
+    title: "Composer attachments and drag-and-drop",
+    branch: "feat/composer-attachments",
+    updatedMinutesAgo: 6,
+    status: "running",
+  },
+  {
+    id: "thread-sidebar",
+    projectId: "project-t3code",
+    title: "Sidebar polish: settled sort order",
+    branch: "feat/sidebar-polish",
+    updatedMinutesAgo: 14,
+  },
+  {
+    id: "thread-hero",
+    projectId: "project-site",
+    title: "Interactive hero demo",
+    branch: "feat/hero-demo",
+    updatedMinutesAgo: 31,
+  },
+  {
+    id: "thread-crash",
+    projectId: "project-mobile",
+    title: "Crash-free sessions dashboard",
+    branch: "feat/crash-dashboard",
+    updatedMinutesAgo: 48,
+  },
+  {
+    id: "thread-pricing",
+    projectId: "project-site",
+    title: "Pricing page copy refresh",
+    branch: null,
+    updatedMinutesAgo: 60 * 4,
+    settled: true,
+  },
+];
+
+const modelSelection = { instanceId: PROVIDER, model: MODEL };
+
+function threadShell(spec: ThreadSpec) {
+  const updatedAt = minutesAgo(spec.updatedMinutesAgo);
+  return {
+    id: spec.id,
+    projectId: spec.projectId,
+    title: spec.title,
+    providerInstanceId: PROVIDER,
+    modelSelection,
+    runtimeMode: "full-access",
+    interactionMode: "default",
+    branch: spec.branch,
+    worktreePath: null,
+    activeProviderThreadId: null,
+    lineage: { rootThreadId: spec.id, parentThreadId: null, relationshipToParent: null },
+    forkedFrom: null,
+    createdBy: "user",
+    creationSource: "web",
+    latestRunId: null,
+    activeRunId: null,
+    activityRunStatus: spec.status === "running" ? "running" : null,
+    activityRunStartedAt: spec.status === "running" ? minutesAgo(spec.updatedMinutesAgo) : null,
+    status: spec.status ?? "idle",
+    pendingRuntimeRequest: null,
+    latestVisibleMessage: spec.lastMessage
+      ? { id: `${spec.id}-last`, role: "assistant", text: spec.lastMessage, updatedAt }
+      : null,
+    latestUserMessageAt: minutesAgo(spec.updatedMinutesAgo + 1),
+    hasActionableProposedPlan: false,
+    itemCount: spec.itemCount ?? 0,
+    visibleItemCount: spec.itemCount ?? 0,
+    createdAt: minutesAgo(spec.updatedMinutesAgo + 30),
+    updatedAt,
+    archivedAt: null,
+    settledOverride: spec.settled ? "settled" : null,
+    settledAt: spec.settled ? updatedAt : null,
+    lastVisitedAt: null,
+    deletedAt: null,
+  };
+}
+
+export const demoShellSnapshot = decodeJson(OrchestrationV2ShellSnapshot)({
+  schemaVersion: 1,
+  snapshotSequence: 1,
+  projects,
+  threads: threadSpecs.map(threadShell),
+  archivedThreads: [],
+});
+
+// ---------------------------------------------------------------------------
+// The conversation
+// ---------------------------------------------------------------------------
+
+type Turn = { readonly role: "user" | "assistant"; readonly text: string };
+
+const conversation: ReadonlyArray<Turn> = [
+  {
+    role: "user",
+    text: "Can themes carry their own CSS? I want a wallpaper behind the chat without forking the app.",
+  },
+  {
+    role: "assistant",
+    text: [
+      "Yes. A theme can now have an optional `css` field, applied after the app's own styles.",
+      "",
+      "### What changed",
+      "",
+      "- The theme editor has a **Custom CSS** section with a live preview.",
+      "- Import and export keep the CSS.",
+      "- Declarations that could load a file are dropped: `@import`, `image-set()`, and any `url()` that isn't `data:`.",
+      "",
+      "A wallpaper is a few lines:",
+      "",
+      "```css",
+      '[data-workspace-area="conversation"] {',
+      "  background-image: url(\"data:image/svg+xml,...\");",
+      "  background-size: cover;",
+      "}",
+      "```",
+    ].join("\n"),
+  },
+  { role: "user", text: "Does it work in dark mode too?" },
+  {
+    role: "assistant",
+    text: "Theme CSS applies in both modes. Scope a rule with `.dark` or `:root:not(.dark)` when it should only apply to one of them.",
+  },
+];
+
+function projection(threadId: string, turns: ReadonlyArray<Turn>) {
+  const shell = threadShell(threadSpecs.find((spec) => spec.id === threadId)!);
+  const items = turns.map((turn, index) => {
+    const at = minutesAgo(turns.length - index + 1);
+    const base = {
+      id: `${threadId}-item-${index}`,
+      threadId,
+      runId: null,
+      nodeId: null,
+      providerThreadId: null,
+      providerTurnId: null,
+      nativeItemRef: null,
+      parentItemId: null,
+      ordinal: index,
+      status: "completed",
+      title: null,
+      startedAt: at,
+      completedAt: at,
+      updatedAt: at,
+      messageId: `${threadId}-message-${index}`,
+      text: turn.text,
+      attachments: [],
+    };
+    return turn.role === "user"
+      ? {
+          ...base,
+          type: "user_message",
+          createdBy: "user",
+          creationSource: "web",
+          inputIntent: "turn_start",
+        }
+      : { ...base, type: "assistant_message", streaming: false };
+  });
+  const messages = turns.map((turn, index) => {
+    const at = minutesAgo(turns.length - index + 1);
+    return {
+      id: `${threadId}-message-${index}`,
+      threadId,
+      runId: null,
+      nodeId: null,
+      role: turn.role,
+      text: turn.text,
+      attachments: [],
+      streaming: false,
+      createdBy: turn.role === "user" ? "user" : "agent",
+      creationSource: "web",
+      createdAt: at,
+      updatedAt: at,
+    };
+  });
+  return decodeJson(OrchestrationV2ThreadProjection)({
+    thread: {
+      id: shell.id,
+      projectId: shell.projectId,
+      title: shell.title,
+      providerInstanceId: shell.providerInstanceId,
+      modelSelection: shell.modelSelection,
+      runtimeMode: shell.runtimeMode,
+      interactionMode: shell.interactionMode,
+      branch: shell.branch,
+      worktreePath: shell.worktreePath,
+      activeProviderThreadId: null,
+      lineage: shell.lineage,
+      forkedFrom: null,
+      createdBy: "user",
+      creationSource: "web",
+      createdAt: shell.createdAt,
+      updatedAt: shell.updatedAt,
+      archivedAt: null,
+      settledOverride: shell.settledOverride,
+      settledAt: shell.settledAt,
+      lastVisitedAt: null,
+      deletedAt: null,
+    },
+    runs: [],
+    attempts: [],
+    nodes: [],
+    subagents: [],
+    providerSessions: [],
+    providerThreads: [],
+    providerTurns: [],
+    runtimeRequests: [],
+    messages,
+    plans: [],
+    turnItems: items,
+    checkpointScopes: [],
+    checkpoints: [],
+    contextHandoffs: [],
+    contextTransfers: [],
+    visibleTurnItems: items.map((item, index) => ({
+      position: index,
+      visibility: "local",
+      sourceThreadId: threadId,
+      sourceItemId: item.id,
+      item,
+    })),
+    updatedAt: shell.updatedAt,
+  });
+}
+
+const projectionCache = new Map<string, OrchestrationV2ThreadProjection>();
+
+/** The projection for a demo thread; threads other than the showcase one are empty. */
+export function demoThreadProjection(threadId: string): OrchestrationV2ThreadProjection | null {
+  if (!threadSpecs.some((spec) => spec.id === threadId)) return null;
+  let cached = projectionCache.get(threadId);
+  if (!cached) {
+    cached = projection(threadId, threadId === DEMO_THREAD_ID ? conversation : []);
+    projectionCache.set(threadId, cached);
+  }
+  return cached;
+}
